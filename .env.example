# SentriQ Production & Development Configuration Template
PROJECT_NAME="SentriQ"
PROJECT_DESCRIPTION="Real-Time Transaction Risk & Fraud Rule Engine"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Database Connection (Supabase PostgreSQL asyncpg for production / SQLite aiosqlite for dev)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Authentication Secrets (Generate strong secret key via: openssl rand -hex 32)
SECRET_KEY="replace_with_a_secure_random_64_character_hex_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External IP Intelligence Service Configuration
IP_INTEL_SERVICE_URL="https://api.ip-intel.internal"
IP_INTEL_TIMEOUT_SECONDS=3.0
IP_INTEL_API_KEY="replace_with_production_ip_intel_api_key"
